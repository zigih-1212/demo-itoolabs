# =============================================================================
# Переменные окружения backend
# Скопируйте в `.env` (см. корневой .env.example с описанием всех ключей).
# =============================================================================
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/voxdesk.sqlite

JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@voxdesk.local
SEED_ADMIN_PASSWORD=admin12345
