# Фронтенд VoxDesk — переменные окружения для Vite.
#
# ВАЖНО: Vite отдаёт в код только переменные с префиксом VITE_.
# Это защита от случайной утечки секретов: всё, что попадёт в бандл,
# увидит любой пользователь в браузере. Секретов здесь быть не должно.
#
# Скопируйте файл и поменяйте значения под себя:
#   Copy-Item .env.example .env   (PowerShell)
#   cp .env.example .env          (bash)

# Базовый URL API. Пустое значение = использовать относительный путь /api,
# который в dev-режиме проксируется Vite-сервером на backend (см. vite.config.ts).
VITE_API_BASE_URL=/api

# Таймаут HTTP-запросов в миллисекундах. По истечении запрос прерывается,
# чтобы интерфейс не «висел» вечно при недоступном сервере.
VITE_API_TIMEOUT=15000
