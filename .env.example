# =============================================================================
# VoxDesk — шаблон переменных окружения
# =============================================================================
# КАК ПОЛЬЗОВАТЬСЯ:
#   1. Скопируйте этот файл в `.env`:
#        Windows (PowerShell):  Copy-Item .env.example .env
#        Linux / macOS:         cp .env.example .env
#   2. Замените значения секретов (JWT_SECRET и т.п.) на свои.
#
# ВАЖНО: файл `.env` добавлен в .gitignore и НИКОГДА не попадает в репозиторий.
# Секреты (пароли, ключи) нельзя коммитить в git — это утечка данных.
# =============================================================================

# --- Общие настройки backend ---
# Порт, на котором слушает API.
PORT=4000
# Окружение: development | test | production
NODE_ENV=development

# --- База данных ---
# Путь к файлу SQLite. Создаётся автоматически при первом запуске миграций.
DATABASE_PATH=./data/voxdesk.sqlite

# --- Аутентификация (JWT) ---
# Секрет для подписи access-токена. ОБЯЗАТЕЛЬНО замените в проде!
JWT_ACCESS_SECRET=change-me-access-secret-in-production
# Секрет для подписи refresh-токена. Должен отличаться от access-секрета!
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
# Время жизни токенов (формат из библиотеки `ms`: 15m, 1h, 7d ...)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Стоимость хеширования пароля bcrypt (10–12 — разумный баланс).
BCRYPT_ROUNDS=10

# --- CORS ---
# Адрес фронтенда в разработке (кто может обращаться к API из браузера).
CORS_ORIGIN=http://localhost:5173

# --- Логирование ---
# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# --- Параметры сидирования (демо-данные) ---
# Email/пароль администратора, который создаётся при `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@voxdesk.local
SEED_ADMIN_PASSWORD=admin12345
